{
    "name": "contenir/cache-mezzio",
    "description": "Mezzio (PSR-15) adapter for contenir/cache: a full-page output cache middleware controlled by the Contenir admin.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "contenir",
        "mezzio",
        "psr-15",
        "page-cache",
        "middleware"
    ],
    "require": {
        "php": "^8.3",
        "contenir/cache": "^0.1",
        "contenir/config": "^0.1",
        "laminas/laminas-diactoros": "^3.0",
        "psr/clock": "^1.0",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-middleware": "^1.0",
        "psr/simple-cache": "^1.0 || ^2.0 || ^3.0"
    },
    "require-dev": {
        "laminas/laminas-cache": "^3.12",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.4",
        "laminas/laminas-serializer": "^2.17",
        "php-db/phpdb-qa-tools": "0.1.x-dev",
        "phpunit/phpunit": "^11.5"
    },
    "suggest": {
        "laminas/laminas-cache": "To back the page cache with a laminas-cache storage adapter (the setup the Contenir admin's purge button understands)."
    },
    "autoload": {
        "psr-4": {
            "Contenir\\Cache\\Mezzio\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Contenir\\Cache\\Mezzio\\Test\\": "test/"
        }
    },
    "repositories": {
        "contenir-cache-local": {
            "type": "path",
            "url": "../contenir-cache",
            "canonical": false,
            "options": {
                "symlink": true
            }
        },
        "contenir-config-local": {
            "type": "path",
            "url": "../contenir-config",
            "canonical": false,
            "options": {
                "symlink": true
            }
        },
        "contenir-cache": {
            "type": "vcs",
            "url": "https://github.com/contenir/cache"
        },
        "contenir-config": {
            "type": "vcs",
            "url": "https://github.com/contenir/config"
        }
    },
    "extra": {
        "laminas": {
            "config-provider": "Contenir\\Cache\\Mezzio\\ConfigProvider"
        }
    },
    "scripts": {
        "check": [
            "@quality",
            "@test"
        ],
        "cs-check": [
            "mago format --check",
            "mago lint"
        ],
        "cs-fix": [
            "mago format",
            "mago lint --fix"
        ],
        "analyze": "mago analyze",
        "quality": [
            "@cs-check",
            "@analyze"
        ],
        "quality:fix": [
            "@cs-fix",
            "@quality"
        ],
        "test": "phpunit --colors=always",
        "test:unit": "phpunit --colors=always --testsuite unit",
        "test:integration": "phpunit --colors=always --testsuite integration",
        "test-coverage": "XDEBUG_MODE=coverage phpunit --colors=always --coverage-clover clover.xml --coverage-text"
    },
    "config": {
        "sort-packages": true
    }
}
